{
  "name": "x-ray-hand-tracker",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --format=esm --external:express",
    "start": "node dist/index.js",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.34",
    "@react-three/fiber": "9.5.0",
    "express": "4.21.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "three": "0.183.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.0.0",
    "typescript": "5.6.3",
    "vite": "7.1.7"
  }
}
